// Optimized schema for 50k daily traffic e-commerce
// Based on Schema 2 with improvements

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * ------------------------------
 * Enums
 * ------------------------------
 */
enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  CASH
  VODAFONE_CASH
  INSTAPAY
  VISA
}

enum PricingApplicationType {
  PERCENTAGE
  FIXED
}

enum Language {
  EN
  AR
}

enum AdminRole {
  OWNER
  MANAGER
  SALES
}

enum MessageStatus {
  SENT
  DELIVERED
  SEEN
}

/**
 * ------------------------------
 * Users & Addresses
 * ------------------------------
 */
model User {
  id               Int      @id @default(autoincrement())
  authProviderId   String   @unique // Links to auth.users.id
  name             String?
  email            String   @unique
  avatar           String? // From OAuth provider
  authProvider     String? // 'google', 'github', 'email', etc.
  phoneNumber      String?
  isActive         Boolean  @default(true)
  role             Role     @default(CUSTOMER)
  lastSession      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  defaultAddressId Int?

  addresses         Address[]
  defaultAddress    Address?           @relation("DefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
  cart              Cart?
  wishlist          Wishlist?
  orders            Order[]
  conversation      Conversation?
  pushSubscriptions PushSubscription[]

  @@index([authProviderId]) // Fast lookup by Supabase auth ID
  @@index([role, isActive])
  @@index([email])
  @@index([lastSession])
}

model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  street     String
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultForUsers User[] @relation("DefaultAddress")

  @@index([userId])
}

/**
 * ------------------------------
 * Categories & Brands
 * ------------------------------
 */
model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  parentId  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent       Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryHierarchy")
  products     Product[]
  translations CategoryTranslation[]

  @@index([parentId])
  @@index([deletedAt]) // For filtering active categories
}

model CategoryTranslation {
  id              Int      @id @default(autoincrement())
  categoryId      Int
  lang            Language
  name            String
  description     String?  @db.Text
  // SEO Fields
  metaTitle       String?  @db.VarChar(70)
  metaDescription String?  @db.VarChar(160)
  metaKeywords    String?  @db.VarChar(255)
  ogTitle         String?  @db.VarChar(70)
  ogDescription   String?  @db.VarChar(200)
  ogImage         String?
  createdAt       DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, lang])
  @@index([categoryId, lang]) // Composite for queries
}

model Brand {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products     Product[]
  translations BrandTranslation[]

  @@index([deletedAt])
}

model BrandTranslation {
  id              Int      @id @default(autoincrement())
  brandId         Int
  lang            Language
  name            String
  description     String?  @db.Text
  // SEO Fields
  metaTitle       String?  @db.VarChar(70)
  metaDescription String?  @db.VarChar(160)
  metaKeywords    String?  @db.VarChar(255)
  ogTitle         String?  @db.VarChar(70)
  ogDescription   String?  @db.VarChar(200)
  ogImage         String?
  createdAt       DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, lang])
  @@index([brandId, lang])
}

/**
 * ------------------------------
 * Products & Variants
 * ------------------------------
 */
model Product {
  id                 Int       @id @default(autoincrement())
  slug               String    @unique
  price              Decimal   @db.Decimal(10, 2)
  salePrice          Decimal?  @db.Decimal(10, 2)
  discountPercentage Decimal?  @db.Decimal(5, 2)
  stock              Int       @default(0)
  isPublished        Boolean   @default(false) // Draft vs Live
  isHeroFeatured     Boolean   @default(false) // Featured in hero section
  isArchived         Boolean   @default(false) // Soft delete
  images             String[]  @default([])
  rating             Decimal?  @db.Decimal(3, 2)
  categoryId         Int?
  brandId            Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  category      Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand         Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  translations  ProductTranslation[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([categoryId, isPublished, isArchived, deletedAt]) // Common filter combo
  @@index([brandId, isPublished, isArchived, deletedAt])
  @@index([isPublished, createdAt]) // For "new arrivals"
  @@index([isPublished, rating]) // For "top rated"
}

model ProductTranslation {
  id               Int      @id @default(autoincrement())
  productId        Int
  lang             Language
  name             String
  shortDescription String?  @db.Text
  description      String?  @db.Text
  // SEO Fields
  metaTitle        String?  @db.VarChar(70)
  metaDescription  String?  @db.VarChar(160)
  metaKeywords     String?  @db.VarChar(255)
  ogTitle          String?  @db.VarChar(70)
  ogDescription    String?  @db.VarChar(200)
  ogImage          String?
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, lang])
  @@index([productId, lang])
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  productId  Int
  sku        String?  @unique
  attributes Json? // {"color": "red", "size": "M"}
  price      Decimal  @db.Decimal(10, 2)
  salePrice  Decimal? @db.Decimal(10, 2)
  stock      Int      @default(0)
  images     String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([productId])
  @@index([sku])
}

/**
 * ------------------------------
 * Cart & Wishlist
 * ------------------------------
 */
model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  variantId Int?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int
  productId  Int
  variantId  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
  @@index([productId])
  @@index([variantId])
}

/**
 * ------------------------------
 * Orders
 * ------------------------------
 */
model Order {
  id              Int           @id @default(autoincrement())
  userId          Int?
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal?      @db.Decimal(12, 2)
  shippingCost    Decimal       @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  customerName    String
  shippingPhone   String
  shippingStreet  String
  shippingCity    String
  shippingCountry String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  timeline OrderTimeline[]

  @@index([userId])
  @@index([status, createdAt]) // Admin dashboard queries
  @@index([createdAt])
  @@index([paymentMethod])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  productId  Int
  variantId  Int?
  quantity   Int
  price      Decimal  @db.Decimal(12, 2)
  totalPrice Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderTimeline {
  id          Int         @id @default(autoincrement())
  orderId     Int
  status      OrderStatus
  changedById Int? // Admin who changed status
  note        String?     @db.Text
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([changedById])
}

/**
 * ------------------------------
 * Pricing & Promo Codes
 * ------------------------------
 */
model PricingSettings {
  id                     Int      @id @default(autoincrement())
  shippingFee            Decimal? @db.Decimal(12, 2)
  minOrderValue          Decimal? @db.Decimal(12, 2)
  maxOrderValue          Decimal? @db.Decimal(12, 2)
  bulkDiscountThreshold  Decimal? @db.Decimal(12, 2)
  bulkDiscountPercentage Decimal? @db.Decimal(5, 2)
  currency               String   @default("EGP")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  promoCodes PricePromoCode[]
}

model PricePromoCode {
  id                Int                    @id @default(autoincrement())
  pricingSettingsId Int?
  code              String                 @unique
  applicationType   PricingApplicationType
  value             Decimal                @db.Decimal(12, 2)
  validFrom         DateTime?
  validTo           DateTime?
  usageLimit        Int?
  usageCount        Int                    @default(0)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  pricingSettings PricingSettings? @relation(fields: [pricingSettingsId], references: [id], onDelete: SetNull)

  @@index([code, isActive]) // Quick promo validation
  @@index([validFrom, validTo])
}

/**
 * ------------------------------
 * Settings
 * ------------------------------
 */
model AppSettings {
  id               Int      @id @default(autoincrement())
  storeName        String
  storeDescription String?  @db.Text
  currency         String   @default("EGP")
  languageOptions  String[] @default(["en", "ar"])
  defaultLanguage  String   @default("en")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ContactSettings {
  id                 Int      @id @default(autoincrement())
  phoneNumber        String?
  vodafoneCashNumber String?
  instaPayUrl        String?
  instaPayQrCode     String?
  instaPayNumber     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SocialSettings {
  id            Int      @id @default(autoincrement())
  facebookGroup String?
  facebookPage  String?
  instagramPage String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StorefrontContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SEO for static pages (home, about, contact, etc.)
model PageSEO {
  id             Int      @id @default(autoincrement())
  pageKey        String // e.g., 'home', 'about', 'contact', 'products', 'categories'
  lang           Language
  title          String   @db.VarChar(70)
  description    String?  @db.VarChar(160)
  keywords       String?  @db.VarChar(255)
  ogTitle        String?  @db.VarChar(70)
  ogDescription  String?  @db.VarChar(200)
  ogImage        String?
  canonicalUrl   String?
  robots         String?  @default("index, follow")
  structuredData Json? // JSON-LD schema
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([pageKey, lang])
  @@index([pageKey, lang])
}

/**
 * ------------------------------
 * Admin Management
 * ------------------------------
 */
model Admin {
  id           Int       @id @default(autoincrement())
  name         String?
  email        String    @unique
  passwordHash String
  role         AdminRole @default(SALES)
  isActive     Boolean   @default(true)
  createdById  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy         Admin?             @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins     Admin[]            @relation("AdminCreatedBy")
  sessions          AdminSession[]
  pushSubscriptions PushSubscription[]

  notifyOrders   Boolean @default(true)
  notifyMessages Boolean @default(true)

  @@index([email])
  @@index([role, isActive])
}

model AdminSession {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  adminId   Int
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token, expiresAt]) // Session validation
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    Int?
  adminId   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adminId])
}

/**
 * ------------------------------
 * Chat/Support
 * ------------------------------
 */
model Conversation {
  id                 String    @id @default(uuid())
  userId             Int       @unique
  lastMessageAt      DateTime  @default(now())
  lastMessageContent String?   @db.Text
  unreadCount        Int       @default(0)
  isActive           Boolean   @default(true)
  adminLastRepliedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Chat[]

  @@index([userId])
  @@index([lastMessageAt])
  @@index([isActive, unreadCount]) // Active conversations with unread
}

model Chat {
  id             String        @id @default(uuid())
  conversationId String
  userId         Int?
  isFromAdmin    Boolean       @default(false)
  content        String        @db.Text
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
}
