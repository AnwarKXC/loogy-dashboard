// ============================================================================
// E-COMMERCE SCHEMA - Guest-First Approach (Cleaned)
// ============================================================================
//
// ARCHITECTURE:
// - Guest checkout only (no customer accounts)
// - Phone number as customer identifier for auto-fill
// - Cart/Wishlist stored in localStorage (not database)
// - Cart sharing via URL parameters (?items=slug1:qty1,slug2:qty2)
//
// REMOVED MODELS:
// - User, Address (no customer accounts)
// - Cart, CartItem (localStorage)
// - Wishlist, WishlistItem (localStorage)
// - Conversation, Chat (no chat support)
// - ProductReview (keeping only Testimonials)
//
// REMOVED ENUMS:
// - Role (no customer role needed)
// - MessageStatus (no chat)
// - ReviewStatus (no reviews)
//
// CURRENCY: Single source of truth in AppSettings.currency
//
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

/// Order lifecycle status
/// PENDING -> PROCESSING -> SHIPPING -> DELIVERED
/// Can be CANCELLED or RETURNED at various stages
enum OrderStatus {
  PENDING // Order placed, awaiting processing
  PROCESSING // Order confirmed, preparing for shipment
  SHIPPING // Order handed to courier
  DELIVERED // Order delivered to customer
  CANCELLED // Order cancelled (by admin or customer request)
  RETURNED // Order returned after delivery
}

/// Supported payment methods in Egypt
enum PaymentMethod {
  CASH // Cash on delivery (COD)
  VODAFONE_CASH // Vodafone Cash mobile wallet
  INSTAPAY // InstaPay bank transfer
  VISA // Credit/Debit card (future)
}

/// How promo code discount is applied
enum PricingApplicationType {
  PERCENTAGE // e.g., 10% off
  FIXED // e.g., 50 EGP off
}

/// Supported languages for translations
enum Language {
  EN // English
  AR // Arabic
}

/// Admin user roles with different permissions
enum AdminRole {
  OWNER // Full access, can manage other admins
  MANAGER // Can manage products, orders, settings
  SALES // Can view/manage orders only
}

/// Inventory movement types for stock tracking
enum InventoryMovementType {
  SALE // Stock decreased from order
  RESTOCK // Stock added from supplier
  ADJUSTMENT // Manual stock correction
  RETURN // Stock returned from customer
  DAMAGE // Stock lost due to damage
}

// ============================================================================
// CATEGORIES & BRANDS
// ============================================================================
// Product organization through categories (hierarchical) and brands.
// Features:
// - Multi-language translations (EN, AR)
// - SEO fields per translation
// - Soft delete support (deletedAt)
// - Hierarchical categories (parent/children)
// ============================================================================

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  parentId  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent       Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryHierarchy")
  products     Product[]
  translations CategoryTranslation[]

  @@index([parentId])
  @@index([deletedAt])
}

model CategoryTranslation {
  id              Int      @id @default(autoincrement())
  categoryId      Int
  lang            Language
  name            String
  description     String?  @db.Text
  metaTitle       String?  @db.VarChar(70)
  metaDescription String?  @db.VarChar(160)
  metaKeywords    String?  @db.VarChar(255)
  ogTitle         String?  @db.VarChar(70)
  ogDescription   String?  @db.VarChar(200)
  ogImage         String?
  createdAt       DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, lang])
  @@index([categoryId, lang])
}

model Brand {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products     Product[]
  translations BrandTranslation[]

  @@index([deletedAt])
}

model BrandTranslation {
  id              Int      @id @default(autoincrement())
  brandId         Int
  lang            Language
  name            String
  description     String?  @db.Text
  metaTitle       String?  @db.VarChar(70)
  metaDescription String?  @db.VarChar(160)
  metaKeywords    String?  @db.VarChar(255)
  ogTitle         String?  @db.VarChar(70)
  ogDescription   String?  @db.VarChar(200)
  ogImage         String?
  createdAt       DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, lang])
  @@index([brandId, lang])
}

// ============================================================================
// PRODUCTS & VARIANTS
// ============================================================================
// Core product catalog with variant support.
// Features:
// - Multi-language translations with SEO
// - Product variants (size, color, etc.)
// - Price + sale price with discount percentage
// - Stock tracking at product and variant level
// - Soft delete (deletedAt) and archive (isArchived)
// - Hero featured flag for homepage display
// ============================================================================

model Product {
  id                 Int       @id @default(autoincrement())
  slug               String    @unique
  price              Decimal   @db.Decimal(10, 2)
  salePrice          Decimal?  @db.Decimal(10, 2)
  discountPercentage Decimal?  @db.Decimal(5, 2)
  stock              Int       @default(0)
  isPublished        Boolean   @default(false)
  isHeroFeatured     Boolean   @default(false)
  isArchived         Boolean   @default(false)
  images             String[]  @default([])
  rating             Decimal?  @db.Decimal(3, 2)
  categoryId         Int?
  brandId            Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand        Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  translations ProductTranslation[]
  orderItems   OrderItem[]

  @@index([categoryId, isPublished, isArchived, deletedAt])
  @@index([brandId, isPublished, isArchived, deletedAt])
  @@index([isPublished, createdAt])
  @@index([isPublished, rating])
}

model ProductTranslation {
  id               Int      @id @default(autoincrement())
  productId        Int
  lang             Language
  name             String
  shortDescription String?  @db.Text
  description      String?  @db.Text
  metaTitle        String?  @db.VarChar(70)
  metaDescription  String?  @db.VarChar(160)
  metaKeywords     String?  @db.VarChar(255)
  ogTitle          String?  @db.VarChar(70)
  ogDescription    String?  @db.VarChar(200)
  ogImage          String?
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, lang])
  @@index([productId, lang])
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  productId  Int
  sku        String?  @unique
  attributes Json?
  price      Decimal  @db.Decimal(10, 2)
  salePrice  Decimal? @db.Decimal(10, 2)
  stock      Int      @default(0)
  images     String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
}

// ============================================================================
// ORDERS
// ============================================================================
// Self-contained orders with embedded customer info (guest-first).
//
// Guest Checkout Flow:
// 1. Customer enters phone number
// 2. System checks previous orders by phone for auto-fill
// 3. Customer confirms/modifies shipping info
// 4. Order placed with embedded customer data
//
// Key Fields:
// - customerPhone: Primary identifier for returning customers
// - All customer/shipping info embedded (no foreign keys to User)
//
// Future: OTP verification for order confirmation
// ============================================================================

model Order {
  id              Int           @id @default(autoincrement())
  // Customer info (phone is primary identifier for auto-fill)
  customerPhone   String
  customerName    String
  customerEmail   String?
  // Shipping info (embedded, not linked to Address)
  shippingPhone   String
  shippingStreet  String
  shippingCity    String
  shippingCountry String        @default("Egypt")
  governorateId   Int?
  areaId          Int?
  // Pricing
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal?      @db.Decimal(12, 2)
  shippingCost    Decimal       @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  // Order details
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  promoCode       String?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  governorate Governorate?    @relation(fields: [governorateId], references: [id], onDelete: SetNull)
  area        Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  timeline    OrderTimeline[]

  @@index([customerPhone, createdAt(sort: Desc)]) // Fast lookup for auto-fill
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([governorateId])
  @@index([areaId])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  productId  Int
  variantId  Int?
  quantity   Int
  price      Decimal  @db.Decimal(12, 2)
  totalPrice Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderTimeline {
  id          Int         @id @default(autoincrement())
  orderId     Int
  status      OrderStatus
  changedById Int?
  note        String?     @db.Text
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([changedById])
}

// ============================================================================
// PRICING & PROMO CODES
// ============================================================================
// Pricing configuration and promotional codes.
// NOTE: Currency is defined ONLY in AppSettings.currency
// ============================================================================

model PricingSettings {
  id                     Int      @id @default(autoincrement())
  shippingFee            Decimal? @db.Decimal(12, 2)
  minOrderValue          Decimal? @db.Decimal(12, 2)
  maxOrderValue          Decimal? @db.Decimal(12, 2)
  bulkDiscountThreshold  Decimal? @db.Decimal(12, 2)
  bulkDiscountPercentage Decimal? @db.Decimal(5, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  promoCodes PricePromoCode[]
}

model PricePromoCode {
  id                Int                    @id @default(autoincrement())
  pricingSettingsId Int?
  code              String                 @unique
  applicationType   PricingApplicationType
  value             Decimal                @db.Decimal(12, 2)
  validFrom         DateTime?
  validTo           DateTime?
  usageLimit        Int?
  usageCount        Int                    @default(0)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  pricingSettings PricingSettings? @relation(fields: [pricingSettingsId], references: [id], onDelete: SetNull)

  @@index([code, isActive])
  @@index([validFrom, validTo])
}

// ============================================================================
// SETTINGS
// ============================================================================
// Application configuration split into logical groups.
// IMPORTANT: AppSettings.currency is the SINGLE SOURCE OF TRUTH for currency.
// ============================================================================

model AppSettings {
  id               Int      @id @default(autoincrement())
  storeName        String
  storeDescription String?  @db.Text
  currency         String   @default("EGP") // SINGLE SOURCE OF TRUTH
  languageOptions  String[] @default(["en", "ar"])
  defaultLanguage  String   @default("en")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ContactSettings {
  id                 Int      @id @default(autoincrement())
  phoneNumber        String?
  vodafoneCashNumber String?
  instaPayUrl        String?
  instaPayQrCode     String?
  instaPayNumber     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SocialSettings {
  id            Int      @id @default(autoincrement())
  facebookGroup String?
  facebookPage  String?
  instagramPage String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================================
// TAX CONFIGURATION
// ============================================================================

model TaxSettings {
  id              Int      @id @default(autoincrement())
  isEnabled       Boolean  @default(false)
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  taxName         String   @default("VAT")
  taxNumber       String?
  includedInPrice Boolean  @default(true)
  applyToShipping Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// INVENTORY TRACKING
// ============================================================================

model InventoryMovement {
  id          Int                   @id @default(autoincrement())
  productId   Int
  variantId   Int?
  type        InventoryMovementType
  quantity    Int
  previousQty Int
  newQty      Int
  orderId     Int?
  note        String?               @db.Text
  createdById Int?
  createdAt   DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([type, createdAt])
  @@index([orderId])
}

// ============================================================================
// STOREFRONT CONTENT & SEO
// ============================================================================

model StorefrontContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageSEO {
  id             Int      @id @default(autoincrement())
  pageKey        String
  lang           Language
  title          String   @db.VarChar(70)
  description    String?  @db.VarChar(160)
  keywords       String?  @db.VarChar(255)
  ogTitle        String?  @db.VarChar(70)
  ogDescription  String?  @db.VarChar(200)
  ogImage        String?
  canonicalUrl   String?
  robots         String?  @default("index, follow")
  structuredData Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([pageKey, lang])
  @@index([pageKey, lang])
}

// ============================================================================
// ADMIN MANAGEMENT
// ============================================================================
// Admin users for dashboard access.
// Roles: OWNER, MANAGER, SALES
// ============================================================================

model Admin {
  id           Int       @id @default(autoincrement())
  name         String?
  email        String    @unique
  passwordHash String
  role         AdminRole @default(SALES)
  isActive     Boolean   @default(true)
  createdById  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy         Admin?             @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins     Admin[]            @relation("AdminCreatedBy")
  sessions          AdminSession[]
  pushSubscriptions PushSubscription[]

  notifyOrders Boolean @default(true)

  @@index([email])
  @@index([role, isActive])
}

model AdminSession {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  adminId   Int
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token, expiresAt])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  adminId   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// ============================================================================
// TESTIMONIALS
// ============================================================================
// Simple testimonials from social media screenshots.
// Admin manually adds/approves testimonials.
// ============================================================================

model Testimonial {
  id           Int      @id @default(autoincrement())
  customerName String?  @db.VarChar(100)
  content      String?  @db.Text
  images       String[] @default([])
  source       String?  @db.VarChar(50)
  rating       Int?
  isPublished  Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@index([source])
}

// ============================================================================
// SHIPPING & LOCATION
// ============================================================================
// Egypt-specific shipping configuration.
// Structure: ShippingZone -> Governorate -> Area
// ============================================================================

model Governorate {
  id             Int      @id @default(autoincrement())
  nameEn         String   @db.VarChar(100)
  nameAr         String   @db.VarChar(100)
  slug           String   @unique @db.VarChar(100)
  shippingZoneId Int?
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  areas        Area[]
  shippingZone ShippingZone? @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@index([shippingZoneId])
  @@index([isActive, displayOrder])
}

model Area {
  id            Int      @id @default(autoincrement())
  governorateId Int
  nameEn        String   @db.VarChar(100)
  nameAr        String   @db.VarChar(100)
  slug          String   @db.VarChar(100)
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@unique([governorateId, slug])
  @@index([governorateId, isActive])
}

model ShippingZone {
  id                    Int      @id @default(autoincrement())
  name                  String   @db.VarChar(100)
  price                 Decimal  @db.Decimal(10, 2)
  freeShippingThreshold Decimal? @db.Decimal(10, 2)
  estimatedDays         String?  @db.VarChar(50)
  isActive              Boolean  @default(true)
  displayOrder          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  governorates Governorate[]

  @@index([isActive, displayOrder])
}
