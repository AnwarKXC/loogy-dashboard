# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dashboard?schema=public"

# AWS S3
S3_ACCESS_KEY=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your_bucket_name

# WhatsApp Cloud API Configuration
# Get these from: https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v21.0

# Admin WhatsApp number (with country code, e.g., 201234567890)
ADMIN_WHATSAPP_NUMBER=201234567890

# Application URLs
CLIENT_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# Site URL for SEO (MUST be absolute URL with https://)
NUXT_PUBLIC_SITE_URL=https://loogy.store

# Session Secret
SESSION_SECRET=your_session_secret_here
